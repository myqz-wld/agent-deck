{
  "name": "agent-deck",
  "version": "0.1.0",
  "description": "General-purpose coding agent cockpit",
  "main": "build/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && pnpm build-info",
    "preview": "electron-vite preview",
    "build-info": "node scripts/write-build-info.mjs",
    "dist": "pnpm verify:bundled-runtimes && pnpm build:linux-headless && pnpm build && electron-builder",
    "dist:mac": "node scripts/verify-bundled-grok.mjs --target-platform darwin && pnpm verify:macos-worker-sandbox && pnpm build:linux-headless && pnpm build && electron-builder --mac && pnpm check:packaged-macos-worker-sandbox",
    "install:local:mac": "node scripts/install-local-macos.mjs",
    "dist:win": "node scripts/verify-bundled-grok.mjs --target-platform win32 && pnpm build:linux-headless && pnpm build && electron-builder --win",
    "dist:linux": "node scripts/verify-bundled-grok.mjs --target-platform linux && pnpm build:linux-headless && pnpm build && electron-builder --linux",
    "icon:gen": "node scripts/gen-icon-ico.mjs",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs && node scripts/check-core-node-boundaries.mjs",
    "build:linux-headless": "node scripts/build-linux-headless.mjs",
    "build:feishu-runtime": "node scripts/build-feishu-runtime.mjs",
    "deploy:relay-server": "node scripts/deploy-relay-server.mjs",
    "deploy:relay-worker": "node scripts/deploy-relay-worker.mjs",
    "deploy:full-server": "node scripts/deploy-full-server.mjs",
    "build:macos-worker-sandbox": "node scripts/build-macos-worker-sandbox.mjs",
    "check:linux-headless": "node scripts/check-linux-headless.mjs",
    "check:deployment": "node scripts/check-deployment-automation.mjs",
    "check:macos-worker-sandbox": "node scripts/check-macos-worker-sandbox.mjs",
    "check:packaged-macos-worker-sandbox": "node scripts/check-packaged-macos-worker-sandbox.mjs",
    "check:grok-remote-sandbox": "node scripts/check-grok-remote-sandbox.mjs",
    "check:provider-session-live": "AGENT_DECK_PROVIDER_LIVE_ACCEPTANCE=1 vitest run src/hosts/provider-session/live-colima-acceptance.test.ts --reporter=verbose",
    "verify:linux-headless": "pnpm build:linux-headless && pnpm build:feishu-runtime && pnpm check:linux-headless && pnpm check:deployment",
    "verify:macos-worker-sandbox": "pnpm build:macos-worker-sandbox && pnpm check:macos-worker-sandbox",
    "typecheck": "pnpm check:architecture && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test-electron.mjs",
    "test:browser-electron": "node scripts/verify-browser-engine-electron.mjs",
    "test:node": "vitest run",
    "test:watch": "vitest",
    "test:fts5": "node scripts/test-electron.mjs src/main/store/__tests__/db-schema.test.ts src/main/store/search-predicate.test.ts",
    "verify:bundled-runtimes": "node scripts/verify-bundled-grok.mjs && pnpm check:grok-remote-sandbox",
    "logger:check": "bash scripts/logger-check.sh",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.260",
    "@anthropic-ai/sdk": "^0.123.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@iarna/toml": "3.0.0",
    "@larksuiteoapi/node-sdk": "1.73.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex": "^0.153.2",
    "@xai-official/grok": "^1.0.13",
    "better-sqlite3": "11.10.0",
    "electron-log": "^5.4.4",
    "electron-store": "8.2.0",
    "fastify": "^5.12.1",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "0.55.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.14.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@xai-official/grok"
    ]
  },
  "build": {
    "appId": "com.agentdeck.app",
    "productName": "Agent Deck",
    "directories": {
      "output": "build/dist",
      "buildResources": "resources"
    },
    "files": [
      "build/**/*",
      "!build/dist/**",
      "resources/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/linux-headless/local-worker",
        "to": "linux-headless/local-worker"
      },
      {
        "from": "build/linux-headless/local-worker-runtime",
        "to": "linux-headless/local-worker-runtime"
      },
      {
        "from": "build/linux-headless/provider-session-supervisor",
        "to": "linux-headless/provider-session-supervisor"
      },
      {
        "from": "deploy/linux/provider-session",
        "to": "provider-session",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/claude-config",
        "to": "claude-config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/codex-config",
        "to": "codex-config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/grok-config",
        "to": "grok-config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/sounds",
        "to": "sounds",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@openai/codex/**/*",
      "node_modules/@openai/codex-darwin-*/**/*",
      "node_modules/@openai/codex-linux-*/**/*",
      "node_modules/@openai/codex-win32-*/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-linux-*/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**/*",
      "**/node_modules/@xai-official/grok*/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "extraFiles": [
        {
          "from": "build/macos-worker-sandbox/${arch}/Agent Deck Worker CLI",
          "to": "MacOS/Agent Deck Worker CLI"
        },
        {
          "from": "build/macos-worker-sandbox/${arch}/agent-deck-worker-bookmark",
          "to": "MacOS/agent-deck-worker-bookmark"
        },
        {
          "from": "build/macos-worker-sandbox/${arch}/agent-deck-worker-sandbox",
          "to": "MacOS/agent-deck-worker-sandbox"
        },
        {
          "from": "build/macos-worker-sandbox/${arch}/Agent Deck Worker Node",
          "to": "MacOS/Agent Deck Worker Node"
        },
        {
          "from": "build/macos-worker-sandbox/${arch}/providers",
          "to": "MacOS/Agent Deck Worker Providers",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Agent Deck"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    }
  }
}

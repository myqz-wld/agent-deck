{
  "schemaVersion": 2,
  "instanceId": "instance-a",
  "appVersion": "0.1.0",
  "runtimeModule": "/opt/agent-deck/linux-headless/local-worker-runtime/index.mjs",
  "runtimeOptions": {
    "providerContainer": {
      "schemaVersion": 1
    },
    "sessionCreationCatalog": {
      "schemaVersion": 1,
      "adapters": [
        {
          "adapterId": "claude-code",
          "providers": ["company-gateway"],
          "provider": "company-gateway",
          "model": "",
          "thinking": "high",
          "permissionMode": "bypassPermissions"
        },
        {
          "adapterId": "codex-cli",
          "providers": ["company-provider"],
          "provider": "company-provider",
          "model": "",
          "thinking": "high",
          "approvalPolicy": "never"
        },
        {
          "adapterId": "grok-build",
          "model": "grok-4.5",
          "thinking": "high",
          "sessionMode": "default"
        }
      ]
    }
  },
  "generationFile": "/var/lib/agent-deck/workers/worker-config-a/generation.json",
  "ssh": {
    "sshBinary": "/usr/bin/ssh",
    "host": "relay.example.com",
    "port": 22,
    "user": "agent_deck",
    "identityFile": "/var/lib/agent-deck/workers/worker-config-a/ssh/id_ed25519",
    "knownHostsFile": "/var/lib/agent-deck/workers/worker-config-a/ssh/known_hosts",
    "instanceId": "instance-a",
    "workerId": "worker-a",
    "credentialId": "worker-credential-a",
    "connectTimeoutSeconds": 15
  },
  "workspaceSandbox": {
    "schemaVersion": 1,
    "execution": "relay-worker",
    "workerConfigId": "worker-config-a",
    "workerId": "worker-a",
    "workspaceRoot": "/srv/workspaces/production",
    "privateRoot": "/var/lib/agent-deck/workers/worker-config-a",
    "runtimeReadRoots": [
      "/opt/agent-deck",
      "/usr/bin",
      "/usr/lib"
    ],
    "environment": {
      "coreConfigRoot": "/var/lib/agent-deck/workers/worker-config-a/core-config",
      "coreRuntimeRoot": "/var/lib/agent-deck/workers/worker-config-a/core-runtime",
      "coreStateRoot": "/var/lib/agent-deck/workers/worker-config-a/core-state",
      "providerCacheRoot": "/var/lib/agent-deck/workers/worker-config-a/provider-cache",
      "providerHomeRoot": "/var/lib/agent-deck/workers/worker-config-a/provider-home",
      "providerTempRoot": "/var/lib/agent-deck/workers/worker-config-a/provider-tmp"
    },
    "networkBoundary": "provider-controlled"
  }
}

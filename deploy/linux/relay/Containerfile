ARG RELAY_RUNTIME_IMAGE
FROM ${RELAY_RUNTIME_IMAGE}

LABEL org.opencontainers.image.title="Agent Deck Relay" \
      io.agent-deck.topology="relay-only" \
      io.agent-deck.accepts-business-persistence="false"

WORKDIR /opt/agent-deck-relay
COPY --chown=10001:10001 build/relay/ ./

USER 10001:10001
ENTRYPOINT ["node", "/opt/agent-deck-relay/index.js"]
CMD ["serve", "--config", "/etc/agent-deck-relay/config.json", "--state", "/var/lib/agent-deck-relay"]

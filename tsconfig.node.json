{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "vitest-setup.ts",
    "src/clients/**/*",
    "src/composition/**/*",
    "src/contracts/**/*",
    "src/core/**/*",
    "src/gateways/**/*",
    "src/hosts/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/protocol/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@clients/*": ["src/clients/*"],
      "@composition/*": ["src/composition/*"],
      "@contracts/*": ["src/contracts/*"],
      "@core/*": ["src/core/*"],
      "@gateways/*": ["src/gateways/*"],
      "@hosts/*": ["src/hosts/*"],
      "@protocol/*": ["src/protocol/*"],
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"]
    }
  }
}

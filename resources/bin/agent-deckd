#!/bin/bash -p
set -euo pipefail
unset AGENT_DECK_HEADLESS_ROOT AGENT_DECK_NODE BASH_ENV ENV \
  LD_LIBRARY_PATH LD_PRELOAD NODE_OPTIONS
PATH=/usr/bin:/bin
export PATH

fail() {
  echo 'Server Core 运行时未正确安装。' >&2
  exit 70
}

verify_root_owned() {
  local path=$1 kind=$2 mode owner
  [[ ! -L "$path" ]] || fail
  [[ "$kind" == directory && -d "$path" || "$kind" == file && -f "$path" ]] || fail
  [[ "$(/usr/bin/readlink -f -- "$path")" == "$path" ]] || fail
  owner="$(/usr/bin/stat -Lc '%u' -- "$path")"
  mode="$(/usr/bin/stat -Lc '%a' -- "$path")"
  [[ "$owner" == 0 ]] || fail
  (( (8#$mode & 8#022) == 0 )) || fail
}

for directory in \
  /opt \
  /opt/agent-deck \
  /opt/agent-deck/bin \
  /opt/agent-deck/linux-headless \
  /opt/agent-deck/linux-headless/server-core \
  /opt/agent-deck/linux-headless/server-core-runtime \
  /opt/agent-deck/providers \
  /opt/agent-deck/providers/claude \
  /opt/agent-deck/providers/codex \
  /opt/agent-deck/providers/grok; do
  verify_root_owned "$directory" directory
done
verify_root_owned /opt/agent-deck/bin/agent-deckd file
verify_root_owned /opt/agent-deck/bin/agent-deck-browser.cjs file
verify_root_owned /usr/bin/node file
verify_root_owned /opt/agent-deck/linux-headless/server-core/index.mjs file
verify_root_owned /opt/agent-deck/linux-headless/server-core-runtime/index.mjs file
for provider in \
  /opt/agent-deck/providers/claude/claude \
  /opt/agent-deck/providers/codex/codex \
  /opt/agent-deck/providers/grok/grok; do
  verify_root_owned "$provider" file
  [[ -x "$provider" ]] || fail
done

exec /usr/bin/env -i \
  HOME=/var/lib/agent-deck PATH=/usr/bin:/bin LANG=C LC_ALL=C \
  XDG_STATE_HOME=/var/lib/agent-deck/state XDG_CONFIG_HOME=/var/lib/agent-deck/config \
  XDG_RUNTIME_DIR=/run \
  SSH_ORIGINAL_COMMAND="${SSH_ORIGINAL_COMMAND-}" \
  /usr/bin/node /opt/agent-deck/linux-headless/server-core/index.mjs "$@"
